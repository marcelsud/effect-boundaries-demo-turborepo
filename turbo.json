{
  "$schema": "https://turborepo.dev/schema.json",
  "globalDependencies": ["tsconfig.base.json"],
  "tasks": {
    "//#boundaries": {
      "cache": false
    },
    "build": {
      "dependsOn": ["//#boundaries", "^build"],
      "outputs": ["dist/**", "tsconfig.tsbuildinfo"]
    },
    "demo": {
      "dependsOn": ["build"],
      "cache": false
    }
  }
}
